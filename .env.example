# Server Configuration
SERVER_PORT=7777
NODE_ENV=developement

# Database Configuration
DATABASE_URL="mysql://root:mysql@localhost:3306/gateway"

# Database Credentials (for Docker)
DB_USERNAME=root
DB_PASSWORD=mysql
DB_DATABASE_NAME=gateway
DB_PORT=3306

# Redis Configuration
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Mail Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your-mail-user
MAIL_PASS=your-mail-pass
MAIL_FROM=agbcms@gmail.com

# AWS Configuration (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=gateway_requests
RABBITMQ_TIMEOUT=30000

# App Configuration
APP_URL=http://localhost:7777
FRONTEND_URL=http://localhost:3000 