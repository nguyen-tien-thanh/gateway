generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  username          String         @unique
  email             String         @unique
  password          String
  name              String
  address           String
  contact           String
  avatar            String
  status            UserStatus
  token             String
  tokenValidityDate DateTime       @default(now())
  salt              String
  twoFASecret       String?
  twoFAThrottleTime DateTime?      @default(now())
  isTwoFAEnabled    Boolean        @default(false)
  roleId            Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  ext               Int?
  calls             Call[]
  queues            Queue[]
  refreshTokens     RefreshToken[]
  role              Role           @relation(fields: [roleId], references: [id])

  @@index([username])
  @@index([email])
  @@index([name])
  @@index([roleId], map: "user_roleId_fkey")
  @@map("user")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([name])
  @@map("role")
}

model Permission {
  id          Int              @id @default(autoincrement())
  resource    String
  description String
  path        String
  method      String           @default("GET")
  isDefault   Boolean?         @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([resource, description])
  @@index([description])
  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId], map: "role_permission_permissionId_fkey")
  @@map("role_permission")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String
  userAgent String   @db.Text
  browser   String?
  os        String?
  isRevoked Boolean
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([browser])
  @@index([os])
  @@index([userId], map: "refresh_token_userId_fkey")
  @@map("refresh_token")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  slug      String   @unique
  sender    String
  subject   String
  body      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([slug])
  @@map("email_template")
}

model Call {
  id              Int            @id @unique
  hotline         String?
  ext             Int?
  callStartTime   DateTime
  callDuration    Int?
  url             String?
  createdDate     DateTime       @default(now())
  createdBy       Int
  updatedDate     DateTime       @updatedAt
  transcriptionId Int?           @unique
  crmId           Int?           @unique
  summaryId       Int?           @unique
  statusId        Int?
  callTypeId      Int?
  queueId         Int?           @unique
  unitId          Int?
  callType        CallType?      @relation(fields: [callTypeId], references: [id])
  user            User           @relation(fields: [createdBy], references: [id])
  status          Status?        @relation(fields: [statusId], references: [id])
  unit            Unit?          @relation(fields: [unitId], references: [id])
  queue           Queue?
  summary         Summary?
  transcription   Transcription?

  @@index([callTypeId], map: "call_call_callTypeId_fkey")
  @@index([createdBy], map: "call_call_createdBy_fkey")
  @@index([statusId], map: "call_call_statusId_fkey")
  @@index([unitId], map: "call_call_unitId_fkey")
  @@map("call_call")
}

model Unit {
  id    Int    @id @default(autoincrement())
  title String
  calls Call[]

  @@map("call_unit")
}

model Transcription {
  id                  Int     @id @default(autoincrement())
  callId              Int     @unique
  transcription       String? @db.Text
  transcriptionMarked Json?
  call                Call    @relation(fields: [callId], references: [id])

  @@map("call_transcription")
}

model Summary {
  id                Int     @id @default(autoincrement())
  callId            Int     @unique
  steps             Json?
  callTopic         String? @db.Text
  callSummary       String? @db.Text
  productCategory   String?
  productName       String?
  agentAttitude     Int?
  agentOverallScore Int?
  custSentiment     Int?
  custExperience    Int?
  overallOutcome    String? @db.Text
  call              Call    @relation(fields: [callId], references: [id])

  @@map("call_summary")
}

model Status {
  id    Int    @id @default(autoincrement())
  title String
  calls Call[]

  @@map("call_status")
}

model CallType {
  id    Int    @id @default(autoincrement())
  title String
  calls Call[]

  @@map("call_type")
}

model Queue {
  id          Int      @id @default(autoincrement())
  callId      Int      @unique
  phone       String?
  plate       String?
  username    String?
  note        String?
  quanlyxe    Json?
  crm         Json?
  createdDate DateTime @default(now())
  createdBy   Int
  updatedDate DateTime @updatedAt
  call        Call     @relation(fields: [callId], references: [id])
  user        User     @relation(fields: [createdBy], references: [id])

  @@index([createdBy], map: "call_queue_createdBy_fkey")
  @@map("call_queue")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}
